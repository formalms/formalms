<!DOCTYPE html>
<html>
<head>
    <title>MyCertificate</title>
</head>
<body>
{{ Template_getTitleArea(Lang_translate('_MY_CERTIFICATE', 'certificate')) | raw }}
<div class="std_block">
    <ul class="nav nav-tabs" role="tablist">
        {# Primo elemento della lista #}
        <li role="presentation" class="{{ selected_tab == 'cert' ? 'active selected' : '' }}">
            <a href="#cert" aria-controls="cert" role="tab" data-toggle="tab">
                <em>{{ Lang_translate('_CERTIFICATE', 'menu') }}</em>
            </a>
        </li>

        {# Secondo elemento della lista #}
        <li role="presentation" class="{{ selected_tab == 'meta' ? 'active selected' : '' }}">
            <a href="#meta" aria-controls="meta" role="tab" data-toggle="tab">
                <em>{{ Lang_translate('_TITLE_META_CERTIFICATE', 'certificate') }}</em>
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane fade in active" id="cert">
            <table class="table table-striped table-bordered display" style="width:100%" id="mycertificates">
                <thead>
                <tr>
                    {% for column in cert_columns %}
                        <th scope="col"><b>{{ column.label }}</b></th>
                    {% endfor %}
                </tr>
                </thead>
            </table>
        </div><!-- close tabs -->

        <div role="tabpanel" class="tab-pane fade {{ selected_tab == 'meta' ? 'active in' : '' }}" id="meta">
            <table class="table table-striped table-bordered display" style="width:100%" id="mymetacertificates">
                <thead>
                    <tr>
                        <th>{{ Lang_translate('_DATE', 'certificate') }}</th>
                        <th>{{ Lang_translate('_CODE', 'certificate') }}</th>
                        <th>{{ Lang_translate('_NAME', 'certificate') }}</th>
                        <th>{{ Lang_translate('_DOWNLOAD', 'certificate') }}</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div> <!-- close content -->
</div>

<script>
    $("body").on("click", "#pdf_download", function () {
        $(this).attr("title", "{{ Lang_translate('_DOWNLOAD') }}");
        $(this).html("<span>{{ Lang_translate('_DOWNLOAD') }}</span>");
    });

    $(function() {
        var tableId = '#mycertificates';
        var languageObj = {
            'sInfo': "{{ Lang_translate('_FROM') }} _START_  {{ Lang_translate('_TO') }} _END_ {{ Lang_translate('_OF') }} _TOTAL_ ",
            'infoEmpty': '',
            'sEmptyTable': '{{ Lang_translate('_NO_CERT_AVAILABLE', 'certificate') }}'
        };

        $(tableId).FormaTable({
            processing: true,
            serverSide: true,
            scrollX: true,
            order: [[ 0, "asc" ]],
            ajax: {
                url: 'ajax.server.php?r=mycertificate/getMyCertificates',
                type: "POST",
                complete: function(json) {},
            },
            info: false,
            language: languageObj
        });

        $('#mymetacertificates').FormaTable({
            data: {{ metacertificates|raw }},
            columns: [
                { data: 'on_date' },
                { data: 'code' },
                { data: 'cert_name' },
                { data: 'download', orderable: false }
            ],
            language: languageObj,
            info: false,
            scrollX: true,
            width: "100%",
            autoWidth: false
        });

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
        });
    });
</script>
</body>
</html>
