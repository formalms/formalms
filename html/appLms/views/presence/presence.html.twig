<html>
<head>
    <title>Precence</title>
</head>
<body>
{{ Template_getTitleArea(Lang_translate('_ATTENDANCE', 'admin_date')) | raw }}
<div class="std_block">
    {{ Form_openForm('presence_form', 'index.php?r=lms/presence/presence') | raw }}
    {{ Form_openElementSpace() | raw }}
    {{ Form_getDropdown(Lang_translate('_SELECT_EDITION', 'admin_date'), 'id_date', 'id_date', date_for_dropdown, model.getIdDate()) | raw }}
    {{ Form_closeElementSpace() | raw }}

    {{ Form_openElementSpace() }}
    {{ test_type == 1 ? Form_getTextfield(Lang_translate('_MIN_SCORE', 'admin_date'), 'score_min', 'score_min', 255, '') : '' }}
    {{ tb |raw }}
    {{ Form_closeElementSpace() }}
    {{ Form_openButtonSpace() | raw }}
    {{ Form_getButton('save', 'save', Lang_translate('_SAVE', 'admin_date')) | raw }}
    {{ Form_closeButtonSpace() | raw }}
    {{ Form_closeForm() | raw }}
</div>
<script type="text/javascript">
    var _MIN_SCORE_NOT_SET = "'.$lang->def('_MIN_SCORE_NOT_SET').'";
    window.frontend.helpers.Axios.defaults.headers.post['X-Signature'] = window.frontend.config.signature;
    document.getElementById("save").addEventListener("click", controlMinScore);
    document.getElementById("id_date").addEventListener("change", formSubmit);

    function formSubmit()
    {
        var form = document.getElementById("presence_form")
        form.submit();
    }
    function controlMinScore(e) {
        var score = document.getElementById('score_min').value;

        if (score === '') {
            e.preventDefault();
            alert(_MIN_SCORE_NOT_SET);
        }
    }
</script>
</body>
</html>